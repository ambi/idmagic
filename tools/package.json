{
  "name": "@specification-first/tools",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "generate-contract": "bun run generate-contract/src/main.ts",
    "render-spec-docs": "bun run render-spec-docs/src/main.ts",
    "check": "bun run check/src/main.ts",
    "check:workspace": "bun run workspace/src/check-workspace.ts",
    "check:all": "bun run check:workspace",
    "check:workspace-work-items": "bun run check:workspace --work-items --ids",
    "check-ids:workspace": "bun run check:workspace --ids"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@typespec/compiler": "1.15.0",
    "@typespec/http": "1.15.0",
    "@typespec/openapi": "1.15.0",
    "@typespec/openapi3": "1.15.0",
    "@types/bun": "1.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "happy-dom": "20.12.0",
    "markdown-it": "^15.0.1",
    "mermaid": "11.17.2",
    "swagger-ui-dist": "5.32.14",
    "typescript": "7.0.2"
  },
  "scarfSettings": {
    "enabled": false
  }
}
