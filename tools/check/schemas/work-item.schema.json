{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specification-first/schemas/work-item.json",
  "title": "Work Item",
  "description": "docs/formats/work-item-format.md を一次情報とするワークアイテムのスキーマ（同文書からの派生物）。work-items/active/<id>.md に置き、完了時は move-work-item が要約に縮めて work-items/done/ へ移す。",
  "type": "object",
  "required": [
    "id",
    "title",
    "created_at",
    "authors",
    "status",
    "motivation",
    "scope",
    "out_of_scope",
    "verification",
    "risk",
    "risk_notes"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["pending", "in_progress"] } },
        "required": ["status"]
      },
      "then": { "required": ["depends_on"] }
    },
    {
      "if": {
        "properties": { "change_kind": { "enum": ["feature", "bugfix", "operations"] } },
        "required": ["change_kind"]
      },
      "then": { "required": ["affected_spec"] }
    },
    {
      "if": {
        "properties": { "change_kind": { "enum": ["refactor", "docs", "tooling", "maintenance"] } },
        "required": ["change_kind"]
      },
      "then": {
        "oneOf": [{ "required": ["affected_spec"] }, { "required": ["spec_impact"] }]
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "ファイル名 (拡張子を除く) から導出される安定識別子。frontmatter には書かない。",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "本文冒頭の H1 見出しから導出される。frontmatter には書かない。"
    },
    "created_at": {
      "description": "起票日。YYYY-MM-DD または RFC3339。",
      "oneOf": [{ "type": "string", "format": "date" }, { "type": "string", "format": "date-time" }]
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "cancelled"]
    },
    "priority": {
      "description": "着手順の推奨。depends_on が表す完了前提とは独立で、拘束力を持たない。未指定は未評価を意味する。",
      "type": "string",
      "enum": ["p0", "p1", "p2", "p3"]
    },
    "depends_on": {
      "description": "この work-item の完了前に完了が必要な work-item ID。一時的な関連や後続候補は含めない。",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^wi-[0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "change_kind": {
      "type": "string",
      "enum": ["feature", "bugfix", "operations", "refactor", "docs", "tooling", "maintenance"]
    },
    "motivation": {
      "description": "根拠。なぜこの変更が必要か。",
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "description": "対象範囲。free-form (object / array / string)。",
      "anyOf": [{ "type": "object" }, { "type": "array" }, { "type": "string", "minLength": 1 }]
    },
    "out_of_scope": {
      "description": "範囲外。",
      "type": "array"
    },
    "plan": {
      "description": "中規模以上の work-item における実装前の技術方針、設計選択、未決定事項。",
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "description": "途中再開できる粒度の進捗チェックリスト。Markdown checkbox を含む文字列。",
      "type": "string",
      "minLength": 1,
      "pattern": "- \\[[ xX]\\] T[0-9]{3}"
    },
    "affected_spec": {
      "description": "影響する normative scenario / standard ID または TypeSpec symbol への direct reference。",
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["path", "requirement"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "description": "docs/ 直下、docs/modules/<module>/ 直下、または機能スライス docs/modules/<module>/<feature>/ 直下の一次情報。",
                "type": "string",
                "pattern": "^docs/(?:[^/]+|(?:requirements|architecture|verification|operations)/[^/]+|design/(?:application|data|infrastructure|security|reliability|performance|observability)/[^/]+|modules/[^/]+/[^/]+/[^/]+/[^/]+|modules/[^/]+/[^/]+/[^/]+|modules/[^/]+/[^/]+|modules/[^/]+)\\.md$"
              },
              "requirement": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
              "impact": { "$ref": "#/$defs/specImpact" }
            }
          },
          {
            "type": "object",
            "required": ["path", "symbol"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "pattern": "^spec/.+\\.tsp$" },
              "symbol": { "type": "string", "minLength": 1 },
              "impact": { "$ref": "#/$defs/specImpact" }
            }
          }
        ]
      }
    },
    "primary_use_cases": {
      "description": "機能または標準対応の観測結果、故障と検証境界。",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/selectedBoundaryPlan" }
    },
    "documentation_impact": {
      "description": "着手時から完了時まで保持する利用者向けリリース文書の影響。",
      "type": "object",
      "required": ["level", "reason", "references"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["none", "release_note", "upgrade_note", "deprecation_notice", "removal_notice"]
        },
        "reason": { "type": "string", "minLength": 10 },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/documentationReference" }
        }
      }
    },
    "maturity_evidence": {
      "description": "FeatureRegistry の成熟度昇格ごとに完了時に残す確認結果。",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/maturityEvidence" }
    },
    "spec_impact": {
      "description": "仕様非影響変更の例外宣言。",
      "type": "object",
      "required": ["kind", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "none" },
        "reason": { "type": "string", "minLength": 10 }
      }
    },
    "verification": {
      "description": "検証コマンド / 手動手順のリスト。",
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["cmd"],
            "properties": {
              "cmd": { "type": "string", "minLength": 1 },
              "in": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        ]
      }
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "reversibility": {
      "description": "Whether the decision this change makes can be taken back afterwards. Independent of risk, and it never relaxes what risk already requires. Optional, so records written before the field existed stay valid.",
      "type": "string",
      "enum": ["reversible", "irreversible"]
    },
    "risk_notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "selectedBoundaryPlan": {
      "type": "object",
      "required": ["id", "requirement", "observable_result", "boundary", "test", "fault_model"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "requirement": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
        "observable_result": { "type": "string", "minLength": 1 },
        "boundary": { "enum": ["unit", "adapter", "acceptance", "contract", "property", "e2e"] },
        "test": { "$ref": "#/$defs/testReference" },
        "fault_model": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "boundary": { "const": "e2e" } } },
      "then": { "required": ["reason"] }
    },
    "selectedBoundaryEvidence": {
      "type": "object",
      "required": ["id", "red", "fault_injection"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "red": { "type": "string", "minLength": 1 },
        "fault_injection": { "type": "string", "minLength": 1 }
      }
    },
    "specImpact": {
      "description": "規範要素を変更するか (modifies)、変更せずに実装を合わせるか (conforms)。省略時は modifies。",
      "type": "string",
      "enum": ["modifies", "conforms"]
    },
    "documentationReference": {
      "type": "object",
      "required": ["kind", "path"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["release_note", "upgrade_note"] },
        "path": {
          "type": "string",
          "pattern": "^docs/releases/(?:changes|upgrades)/wi-[0-9]+(?:-[a-z0-9]+)*\\.md$"
        }
      }
    },
    "maturityEvidence": {
      "type": "object",
      "required": ["feature", "from", "to", "security"],
      "additionalProperties": false,
      "anyOf": [{ "required": ["compatibility"] }, { "required": ["migration"] }],
      "properties": {
        "feature": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "from": { "type": "string", "enum": ["experimental", "preview"] },
        "to": { "type": "string", "enum": ["preview", "supported"] },
        "security": { "type": "string", "minLength": 1 },
        "compatibility": { "type": "string", "minLength": 1 },
        "migration": { "type": "string", "minLength": 1 },
        "documentation": {
          "description": "公開後は必須。公開状態を読む work item 検査が適用条件を判定する。",
          "type": "string",
          "pattern": "^docs/releases/(?:changes|upgrades)/wi-[0-9]+(?:-[a-z0-9]+)*\\.md$"
        }
      }
    },
    "testReference": {
      "type": "object",
      "required": ["path", "name", "task"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      }
    }
  }
}
