{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specification-first/schemas/work-item.json",
  "title": "Work Item",
  "description": "WORK_ITEM_FORMAT.md を正本とするワークアイテムのスキーマ（同文書からの派生物）。work-items/<id>.md に置き、完了時は completion を同じファイルに追記する。",
  "type": "object",
  "required": [
    "id",
    "title",
    "created_at",
    "authors",
    "status",
    "motivation",
    "scope",
    "out_of_scope",
    "verification",
    "risk",
    "risk_notes"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["pending", "in_progress"] } },
        "required": ["status"]
      },
      "then": { "required": ["depends_on"] }
    },
    {
      "if": {
        "properties": { "status": { "const": "in_progress" } },
        "required": ["status"]
      },
      "then": { "required": ["initial_context"] }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["completed", "cancelled"] } },
        "required": ["status"]
      },
      "then": { "required": ["completion"] }
    },
    {
      "if": {
        "properties": { "change_kind": { "enum": ["feature", "bugfix", "operations"] } },
        "required": ["change_kind"]
      },
      "then": { "required": ["affected_spec"] }
    },
    {
      "if": {
        "properties": { "change_kind": { "enum": ["refactor", "docs", "tooling", "maintenance"] } },
        "required": ["change_kind"]
      },
      "then": {
        "oneOf": [{ "required": ["affected_spec"] }, { "required": ["spec_impact"] }]
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "ファイル名 (拡張子を除く) から導出される安定識別子。frontmatter には書かない。",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "本文冒頭の H1 見出しから導出される。frontmatter には書かない。"
    },
    "created_at": {
      "description": "起票日。YYYY-MM-DD または RFC3339。",
      "oneOf": [{ "type": "string", "format": "date" }, { "type": "string", "format": "date-time" }]
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "cancelled"]
    },
    "priority": {
      "description": "着手順の推奨。depends_on が表す完了前提とは独立で、拘束力を持たない。未指定は未評価を意味する。",
      "type": "string",
      "enum": ["p0", "p1", "p2", "p3"]
    },
    "depends_on": {
      "description": "この work-item の完了前に完了が必要な work-item ID。一時的な関連や後続候補は含めない。",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^wi-[0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "change_kind": {
      "type": "string",
      "enum": ["feature", "bugfix", "operations", "refactor", "docs", "tooling", "maintenance"]
    },
    "motivation": {
      "description": "根拠。なぜこの変更が必要か。",
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "description": "対象範囲。free-form (object / array / string)。",
      "anyOf": [{ "type": "object" }, { "type": "array" }, { "type": "string", "minLength": 1 }]
    },
    "out_of_scope": {
      "description": "範囲外。",
      "type": "array"
    },
    "plan": {
      "description": "中規模以上の work-item における実装前の技術方針、設計選択、未決定事項。",
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "description": "途中再開できる粒度の進捗チェックリスト。Markdown checkbox を含む文字列。",
      "type": "string",
      "minLength": 1,
      "pattern": "- \\[[ xX]\\] T[0-9]{3}"
    },
    "initial_context": {
      "description": "着手時 (status: in_progress) に AI が読むべき最小文脈。pending の段階では任意で、着手時に書き直す。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specification": {
          "description": "normative scenario への direct reference。spec/**/SPECIFICATION.md#REQ-<CONTEXT>-NNN 形式。",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "typespec": {
          "description": "読むべき TypeSpec symbol。",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "stop_before_reading": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "scl": {
          "description": "Legacy。廃止済み SCL への参照。完了済み記録の履歴としてのみ許容する。",
          "type": "object"
        },
        "decisions": {
          "description": "Legacy。廃止済み decisions/ ADR への参照。完了済み記録の履歴としてのみ許容する。",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "affected_spec": {
      "description": "影響する normative scenario / standard ID または TypeSpec symbol への direct reference。完了済み履歴では legacy SCL reference も許容する。",
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["path", "requirement"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^spec/(?:SPECIFICATION|contexts/.+/SPECIFICATION)\\.md$"
              },
              "requirement": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" }
            }
          },
          {
            "type": "object",
            "required": ["path", "symbol"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "pattern": "^spec/.+\\.tsp$" },
              "symbol": { "type": "string", "minLength": 1 }
            }
          },
          { "$ref": "#/$defs/sclElementReference" }
        ]
      }
    },
    "spec_impact": {
      "description": "仕様非影響変更の例外宣言。",
      "type": "object",
      "required": ["kind", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "none" },
        "reason": { "type": "string", "minLength": 10 }
      }
    },
    "verification": {
      "description": "検証コマンド / 手動手順のリスト。",
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["cmd"],
            "properties": {
              "cmd": { "type": "string", "minLength": 1 },
              "in": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        ]
      }
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "risk_notes": {
      "type": "string",
      "minLength": 1
    },
    "completion": {
      "description": "完了または中止の判断記録。status が completed/cancelled になった時点で追記する。",
      "type": "object",
      "required": ["completed_at", "summary"],
      "properties": {
        "completed_at": {
          "oneOf": [
            { "type": "string", "format": "date" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "summary": {
          "description": "意味上の差分の要約。",
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "description": "検証結果。",
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "required": ["cmd"],
                "properties": {
                  "cmd": { "type": "string", "minLength": 1 },
                  "in": { "type": "string" },
                  "result": {}
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sclElementReference": {
      "oneOf": [
        {
          "type": "object",
          "required": ["context", "kind", "element"],
          "additionalProperties": false,
          "properties": {
            "context": { "type": "string", "minLength": 1 },
            "kind": {
              "enum": [
                "model",
                "interface",
                "state",
                "authorization_resource",
                "authorization_principal",
                "authorization_policy",
                "objective",
                "scenario",
                "flow"
              ]
            },
            "element": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["context", "kind", "standard", "requirement"],
          "additionalProperties": false,
          "properties": {
            "context": { "type": "string", "minLength": 1 },
            "kind": { "const": "standard_requirement" },
            "standard": { "type": "string", "minLength": 1 },
            "requirement": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
