{
  "name": "idmagic-ui",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.app.json && bun ./node_modules/vite/bin/vite.js build",
    "dev": "bun ./node_modules/vite/bin/vite.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "check:deps": "knip",
    "test:e2e": "bun test --config=tests/e2e/bunfig.toml tests/e2e/",
    "test:unit": "bun test src/",
    "test:unit:coverage": "bun test --coverage src/",
    "generate:routes": "bun run scripts/generate-routes.ts",
    "add:component": "shadcn add"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@tabler/icons-react": "3.47.0",
    "@tanstack/react-router": "1.170.38",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@happy-dom/global-registrator": "20.14.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.38",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "bun-types": "1.4.2",
    "knip": "6.37.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
