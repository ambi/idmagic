{
  "name": "idmagic-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.app.json && bun ./node_modules/vite/bin/vite.js build",
    "dev": "bun ./node_modules/vite/bin/vite.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:e2e": "bun test tests/e2e/ui-scenario-actions.spec.ts && bun test tests/e2e/ui-scenario-smoke.spec.ts && bun test tests/e2e/admin-session-recovery.spec.ts && bun test tests/e2e/authorize-golden-path.spec.ts",
    "test:unit": "bun test src/",
    "test:unit:coverage": "bun test --coverage src/",
    "generate:routes": "bun run scripts/generate-routes.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-table": "^9.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@happy-dom/global-registrator": "^20.11.13",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "bun-types": "^1.4.0",
    "happy-dom": "^20.11.13",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
