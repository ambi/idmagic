{
  "name": "SigningKeyLifecycle",
  "states": [
    {
      "name": "Active",
      "kind": "initial",
      "meaning": "新しいメッセージへの署名に使う。テナント、用途、スコープの組ごとに 1 本だけ存在する"
    },
    {
      "name": "Prepared",
      "kind": "—",
      "meaning": "メタデータに事前公開する XML 鍵。署名には使わず、集合ごとに一つだけ存在する"
    },
    {
      "name": "Verifying",
      "kind": "—",
      "meaning": "署名には使わないが、JWKS とフェデレーションメタデータに載せて検証に使う"
    },
    {
      "name": "Retired",
      "kind": "—",
      "meaning": "公開の重複期間（`expires_at`）を過ぎ、JWKS から除外した。公開しない"
    },
    {
      "name": "Archived",
      "kind": "terminal",
      "meaning": "監査保管。退役した鍵で署名された監査トークンを検証できるよう鍵素材を保持する"
    }
  ],
  "transitions": [
    {
      "from": "Active",
      "event": "SigningKeyRotated",
      "guard": "—",
      "to": "Verifying",
      "effects": ""
    },
    {
      "from": "Prepared",
      "event": "SigningKeyRotated",
      "guard": "管理者が信頼の更新を確認した",
      "to": "Active",
      "effects": ""
    },
    {
      "from": "Prepared",
      "event": "管理者による無効化",
      "guard": "—",
      "to": "Archived",
      "effects": ""
    },
    {
      "from": "Verifying",
      "event": "SigningKeyRetired",
      "guard": "`expires_at` を過ぎた",
      "to": "Retired",
      "effects": ""
    },
    {
      "from": "Retired",
      "event": "SigningKeyArchived",
      "guard": "—",
      "to": "Archived",
      "effects": ""
    },
    {
      "from": "Verifying",
      "event": "管理者による無効化",
      "guard": "—",
      "to": "Archived",
      "effects": ""
    },
    {
      "from": "Retired",
      "event": "管理者による無効化",
      "guard": "—",
      "to": "Archived",
      "effects": ""
    }
  ],
  "operations": [
