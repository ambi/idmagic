      "name": "tools-list-first-page",
      "source": "要求は basic/authorization「Token Requirements」（Authorization を除く）、応答は server/tools「Listing Tools」",
      "setup": {
        "tools": [
          {
            "name": "get_weather",
            "title": "Weather Information Provider",
            "description": "Get current weather information for a location",
            "inputSchema": {
              "type": "object",
              "properties": {
                "location": {
                  "type": "string",
                  "description": "City name or zip code"
                }
              },
              "required": [
