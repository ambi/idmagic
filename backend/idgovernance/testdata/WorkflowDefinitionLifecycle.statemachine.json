{
  "name": "WorkflowDefinitionLifecycle",
  "states": [
    {
      "name": "draft",
      "kind": "initial",
      "meaning": "作成直後。トリガーの評価対象にならない"
    },
    {
      "name": "enabled",
      "kind": "—",
      "meaning": "新しいトリガーの評価対象になる"
    },
    {
      "name": "disabled",
      "kind": "—",
      "meaning": "新しいトリガーを止めている。再び有効化できる"
    },
    {
      "name": "archived",
      "kind": "terminal",
      "meaning": "削除済み。参照整合性のために保持し、管理画面と通常の API には公開しない"
    }
  ],
  "transitions": [
