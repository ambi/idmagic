{
  "name": "WorkflowRunLifecycle",
  "states": [
    {
      "name": "queued",
      "kind": "initial",
      "meaning": "作成直後または再試行の後。ディスパッチャーが `job_id` を関連付けるのを待つ"
    },
    {
      "name": "running",
      "kind": "—",
      "meaning": "未完了のステップを定義順に実行している"
    },
    {
      "name": "succeeded",
      "kind": "terminal",
      "meaning": "全ステップが成功した"
    },
    {
      "name": "partially_failed",
      "kind": "—",
      "meaning": "成功と失敗が混在した。管理者が再試行できる"
    },
    {
      "name": "failed",
      "kind": "—",
      "meaning": "成功したステップが 1 つもなかった。管理者が再試行できる"
    },
    {
      "name": "canceled",
      "kind": "terminal",
      "meaning": "ワークフローの無効化により、開始前またはステップの区切りで打ち切った"
    }
  ],
  "transitions": [
    {
      "from": "queued",
      "event": "LifecycleWorkflowRunStarted",
      "guard": "—",
      "to": "running",
      "effects": ""
    },
    {
      "from": "running",
      "event": "LifecycleWorkflowRunSucceeded",
      "guard": "—",
      "to": "succeeded",
      "effects": ""
    },
    {
      "from": "running",
      "event": "LifecycleWorkflowRunPartiallyFailed",
      "guard": "—",
      "to": "partially_failed",
      "effects": ""
    },
    {
      "from": "running",
      "event": "LifecycleWorkflowRunFailed",
      "guard": "—",
      "to": "failed",
      "effects": ""
    },
    {
      "from": "queued",
      "event": "LifecycleWorkflowRunCanceled",
      "guard": "—",
      "to": "canceled",
      "effects": ""
    },
    {
      "from": "running",
      "event": "LifecycleWorkflowRunCanceled",
      "guard": "—",
      "to": "canceled",
      "effects": ""
    },
    {
      "from": "partially_failed",
      "event": "管理者による再試行",
      "guard": "—",
      "to": "queued",
      "effects": ""
    },
    {
      "from": "failed",
      "event": "管理者による再試行",
      "guard": "—",
      "to": "queued",
      "effects": ""
    }
  ],
  "operations": [
    "実行の開始",
    "試行の終了",
    "ワークフローの無効化",
    "管理者による再試行"
  ],
  "matrix": {
    "queued": {
      "実行の開始": [
        {
          "kind": "transition",
          "to": "running",
          "condition": "同じ User の先行する実行が終わっている"
        },
        {
          "kind": "noop",
          "condition": "先行する実行が終わっていない"
        }
      ],
      "試行の終了": [
        {
          "kind": "noop"
        }
      ],
      "ワークフローの無効化": [
        {
          "kind": "transition",
          "to": "canceled"
        }
      ],
      "管理者による再試行": [
        {
          "kind": "refusal",
          "response": "400 invalid_request"
        }
      ]
    },
    "running": {
      "実行の開始": [
        {
          "kind": "noop"
        }
      ],
      "試行の終了": [
        {
          "kind": "transition",
          "to": "succeeded",
          "condition": "すべてのステップが成功"
        },
        {
          "kind": "noop",
          "condition": "失敗したステップが残り、試行が上限未満"
        },
        {
          "kind": "transition",
          "to": "partially_failed",
          "condition": "試行が上限に達し、成功と失敗が混在"
        },
        {
          "kind": "transition",
          "to": "failed",
          "condition": "試行が上限に達し、成功が一つもない"
        }
      ],
      "ワークフローの無効化": [
        {
          "kind": "transition",
          "to": "canceled",
          "condition": "次のステップの前"
        }
      ],
      "管理者による再試行": [
        {
          "kind": "refusal",
          "response": "400 invalid_request"
        }
      ]
    },
    "succeeded": {
      "実行の開始": [
        {
          "kind": "noop"
        }
      ],
      "試行の終了": [
        {
          "kind": "noop"
        }
      ],
      "ワークフローの無効化": [
        {
          "kind": "noop"
        }
      ],
      "管理者による再試行": [
        {
          "kind": "refusal",
          "response": "400 invalid_request"
        }
      ]
    },
    "partially_failed": {
      "実行の開始": [
        {
          "kind": "noop"
        }
      ],
      "試行の終了": [
        {
          "kind": "noop"
        }
      ],
      "ワークフローの無効化": [
        {
          "kind": "noop"
        }
      ],
      "管理者による再試行": [
        {
          "kind": "transition",
          "to": "queued",
          "condition": "ワークフローが `enabled`"
        },
        {
          "kind": "refusal",
          "response": "400 invalid_request",
          "condition": "ワークフローが `enabled` でない"
        }
      ]
    },
    "failed": {
      "実行の開始": [
        {
          "kind": "noop"
        }
      ],
      "試行の終了": [
        {
          "kind": "noop"
        }
      ],
      "ワークフローの無効化": [
        {
          "kind": "noop"
        }
      ],
      "管理者による再試行": [
        {
          "kind": "transition",
          "to": "queued",
          "condition": "ワークフローが `enabled`"
        },
        {
          "kind": "refusal",
          "response": "400 invalid_request",
          "condition": "ワークフローが `enabled` でない"
        }
      ]
    },
    "canceled": {
      "実行の開始": [
        {
          "kind": "noop"
        }
      ],
      "試行の終了": [
        {
          "kind": "noop"
        }
      ],
      "ワークフローの無効化": [
        {
          "kind": "noop"
        }
      ],
      "管理者による再試行": [
        {
          "kind": "refusal",
          "response": "400 invalid_request"
        }
      ]
    }
  }
}
