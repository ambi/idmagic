{
  "name": "ApprovalRequestLifecycle",
  "states": [
    {
      "name": "Pending",
      "kind": "initial",
      "meaning": "起票済み。人間の判断を待っている"
    },
    {
      "name": "Approved",
      "kind": "—",
      "meaning": "人間が承認した。CIBA の起票は 1 回だけトークンへ引き換えられ、評価の起票は 1 回だけ使用権を記録できる"
    },
    {
      "name": "Denied",
      "kind": "terminal",
      "meaning": "人間が拒否した"
    },
    {
      "name": "Expired",
      "kind": "terminal",
      "meaning": "判断、引き換え、使用の前に有効期間が切れた"
    },
    {
      "name": "Consumed",
      "kind": "terminal",
      "meaning": "承認をトークンへ引き換えたか、評価の起票の使用権を記録した。CAS によりちょうど一度だけ成立する"
    }
  ],
  "transitions": [
    {
      "from": "Pending",
      "event": "Approve",
      "guard": "now() < expires_at",
      "to": "Approved",
      "effects": ""
    },
    {
      "from": "Pending",
      "event": "Deny",
      "guard": "—",
      "to": "Denied",
      "effects": ""
    },
    {
      "from": "Pending",
      "event": "Expire",
      "guard": "—",
      "to": "Expired",
      "effects": ""
    },
    {
      "from": "Approved",
      "event": "Consume",
      "guard": "now() < expires_at",
      "to": "Consumed",
      "effects": ""
    },
    {
      "from": "Approved",
      "event": "Expire",
      "guard": "—",
      "to": "Expired",
      "effects": ""
    }
  ],
  "operations": [
    "承認",
    "拒否",
    "トークンの交換",
    "有効期間の経過",
    "評価による使用"
  ],
  "matrix": {
    "Pending": {
      "承認": [
        {
          "kind": "transition",
          "to": "Approved",
          "condition": "期限内"
        },
        {
          "kind": "refusal",
          "response": "400 invalid_request",
          "condition": "期限切れ"
        }
      ],
      "拒否": [
        {
          "kind": "transition",
          "to": "Denied",
          "condition": "期限内"
        },
        {
          "kind": "refusal",
          "response": "400 invalid_request",
          "condition": "期限切れ"
        }
      ],
      "トークンの交換": [
        {
          "kind": "refusal",
          "response": "400 authorization_pending",
          "condition": "間隔を守った"
        },
        {
          "kind": "refusal",
          "response": "400 slow_down",
          "condition": "間隔より短い"
        },
        {
          "kind": "transition",
          "to": "Expired",
          "condition": "期限切れ。400 expired_token を返す"
        }
      ],
      "有効期間の経過": [
        {
          "kind": "transition",
          "to": "Expired"
        }
      ],
      "評価による使用": [
        {
          "kind": "refusal",
          "response": "200 decision=false approval_pending"
        }
      ]
    },
    "Approved": {
      "承認": [
        {
          "kind": "refusal",
          "response": "400 invalid_request"
        }
      ],
      "拒否": [
        {
          "kind": "refusal",
          "response": "400 invalid_request"
        }
      ],
      "トークンの交換": [
        {
          "kind": "transition",
          "to": "Consumed",
          "condition": "期限内"
        },
        {
          "kind": "transition",
          "to": "Expired",
          "condition": "期限切れ。400 expired_token を返す"
        }
      ],
      "有効期間の経過": [
        {
          "kind": "transition",
          "to": "Expired"
        }
      ],
      "評価による使用": [
        {
          "kind": "transition",
          "to": "Consumed",
          "condition": "評価の起票で期限内。使用権を記録する"
        },
        {
          "kind": "refusal",
          "response": "200 decision=false approval_expired",
          "condition": "CIBA の起票か期限切れ"
        }
      ]
    },
    "Denied": {
      "承認": [
        {
          "kind": "refusal",
          "response": "400 invalid_request"
        }
      ],
      "拒否": [
        {
          "kind": "refusal",
          "response": "400 invalid_request"
        }
      ],
      "トークンの交換": [
        {
          "kind": "refusal",
          "response": "400 access_denied"
        }
      ],
      "有効期間の経過": [
        {
          "kind": "noop"
        }
      ],
      "評価による使用": [
        {
          "kind": "refusal",
          "response": "200 decision=false approval_denied"
        }
      ]
    },
    "Expired": {
      "承認": [
        {
          "kind": "refusal",
          "response": "400 invalid_request"
        }
      ],
      "拒否": [
        {
          "kind": "refusal",
          "response": "400 invalid_request"
        }
      ],
      "トークンの交換": [
        {
          "kind": "refusal",
          "response": "400 expired_token"
        }
      ],
      "有効期間の経過": [
        {
          "kind": "noop"
        }
      ],
      "評価による使用": [
        {
          "kind": "refusal",
          "response": "200 decision=false approval_expired"
        }
      ]
    },
    "Consumed": {
      "承認": [
        {
          "kind": "refusal",
          "response": "400 invalid_request"
        }
      ],
      "拒否": [
        {
          "kind": "refusal",
          "response": "400 invalid_request"
        }
      ],
      "トークンの交換": [
        {
          "kind": "refusal",
          "response": "400 invalid_grant"
        }
      ],
      "有効期間の経過": [
        {
          "kind": "noop"
        }
      ],
      "評価による使用": [
        {
          "kind": "noop",
          "condition": "期限内で使用権が未使用か同じ鍵。許可する"
        },
        {
          "kind": "refusal",
          "response": "200 decision=false approval_already_used",
          "condition": "別の鍵が使用権を持つ"
        },
        {
          "kind": "refusal",
          "response": "200 decision=false approval_expired",
          "condition": "期限切れ"
        }
      ]
    }
  }
}
