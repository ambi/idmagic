{
  "name": "ClientSecretCredentialLifecycle",
  "states": [
    {
      "name": "Active",
      "kind": "initial",
      "meaning": "クライアント認証に使える"
    },
    {
      "name": "Expired",
      "kind": "terminal",
      "meaning": "`expires_at` に達した。認証には使えない"
    },
    {
      "name": "Revoked",
      "kind": "terminal",
      "meaning": "管理者が個別に失効させた。期限切れより優先して表示する"
    }
  ],
  "transitions": [
    {
      "from": "Active",
      "event": "Expire",
      "guard": "now() >= expires_at",
      "to": "Expired",
      "effects": ""
    },
    {
      "from": "Active",
      "event": "ClientSecretRevoked",
      "guard": "—",
      "to": "Revoked",
      "effects": ""
    }
  ],
  "operations": [
    "資格情報の個別の失効",
    "有効期間の経過"
  ],
  "matrix": {
    "Active": {
      "資格情報の個別の失効": [
        {
          "kind": "transition",
          "to": "Revoked"
        }
      ],
      "有効期間の経過": [
        {
          "kind": "transition",
          "to": "Expired"
        }
      ]
    },
    "Expired": {
      "資格情報の個別の失効": [
        {
          "kind": "refusal",
          "response": "400 invalid_request"
        }
      ],
      "有効期間の経過": [
        {
          "kind": "noop"
        }
      ]
    },
    "Revoked": {
      "資格情報の個別の失効": [
        {
          "kind": "noop"
        }
      ],
      "有効期間の経過": [
        {
          "kind": "noop"
        }
      ]
    }
  }
}
