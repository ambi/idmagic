{
  "name": "AuthorizationCodeFlow",
  "states": [
    {
      "name": "Received",
      "kind": "initial",
      "meaning": "`/authorize` が要求を受け取った。まだ検証していない"
    },
    {
      "name": "AuthenticationPending",
      "kind": "—",
      "meaning": "要求は妥当で、主体を決めるログインを待っている"
    },
    {
      "name": "Rejected",
      "kind": "terminal",
      "meaning": "検証、認証、同意のいずれかで拒否した"
    },
    {
      "name": "Authenticated",
      "kind": "—",
      "meaning": "主体が決まった。同意の要否をこれから判定する"
    },
    {
      "name": "Expired",
      "kind": "terminal",
      "meaning": "有効期間内に次の段へ進まなかった"
    },
    {
      "name": "ConsentPending",
      "kind": "—",
      "meaning": "要求スコープが既存の同意で覆えず、同意画面のレスポンスを待っている"
    },
    {
      "name": "CodeIssued",
      "kind": "—",
      "meaning": "認可コードを発行し、`/token` での引き換えを待っている"
    },
    {
      "name": "Consented",
      "kind": "—",
      "meaning": "要求スコープを覆う同意が揃った"
    },
    {
      "name": "Exchanged",
      "kind": "terminal",
      "meaning": "認可コードを引き換えた"
    }
  ],
  "transitions": [
